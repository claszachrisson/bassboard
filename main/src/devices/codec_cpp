constexpr int DMA_FRAME_NUM_SAMPLES = 120;
// constexpr int RING_BUF_ITEM_SIZE = 1024;
constexpr int STREAMBUF_N_FRAMES = 12;
constexpr size_t STREAMBUF_SIZE = DMA_FRAME_NUM_SAMPLES * sizeof(uint16_t) * STREAMBUF_N_FRAMES;
constexpr size_t STREAMBUF_TRIG_LVL = DMA_FRAME_NUM_SAMPLES * sizeof(uint16_t) * 3;

TaskHandle_t Codec::stream_task_handle = nullptr;
StreamBufferHandle_t xStreamBuffer;
StaticStreamBuffer_t StreamBufferStruct;
static uint8_t ucStorageBuffer[STREAMBUF_SIZE];


